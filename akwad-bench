#!/bin/bash
# Akwad Bench Manager for WSL Frappe Environments

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

BASE_WEB=8000
BASE_SOCKET=9000
BASE_QUEUE=11000
BASE_SOCKETIO_REDIS=12000
BASE_CACHE=13000

if ! command -v jq &> /dev/null; then
    echo -e "${RED}Error: 'jq' is required. Run: sudo dnf install jq -y${NC}"
    exit 1
fi

discover_benches() {
    benches=()
    for dir in ~/*/; do
        if [ -f "${dir}sites/common_site_config.json" ]; then
            benches+=("${dir%/}")
        fi
    done
}

show_dashboard() {
    discover_benches
    echo -e "${BLUE}=== Active Bench Environments ===${NC}"
    printf "%-20s %-6s %-8s %-25s %b\n" "Bench Name" "Web" "Socket" "Redis (Cache/Queue/Sock)" "Status"
    echo "-------------------------------------------------------------------------------"

    if [ ${#benches[@]} -eq 0 ]; then
        echo -e "${YELLOW}No benches found in the home directory.${NC}"
        return
    fi

    for bench in "${benches[@]}"; do
        config="${bench}/sites/common_site_config.json"
        name=$(basename "$bench")

        web=$(jq -r '.webserver_port // 8000' "$config")
        socket=$(jq -r '.socketio_port // 9000' "$config")

        cache=$(jq -r '.redis_cache // "13000"' "$config" | grep -o '[0-9]*$')
        queue=$(jq -r '.redis_queue // "11000"' "$config" | grep -o '[0-9]*$')
        redis_sock=$(jq -r '.redis_socketio // "12000"' "$config" | grep -o '[0-9]*$')

        if ss -tuln | grep -q ":$web "; then
            status="${GREEN}[RUNNING]${NC}"
        else
            status="${YELLOW}[STOPPED]${NC}"
        fi

        printf "%-20s %-6s %-8s %-25s %b\n" "$name" "$web" "$socket" "$cache / $queue / $redis_sock" "$status"
    done
    echo "-------------------------------------------------------------------------------"
}

get_next_offset() {
    discover_benches
    max_offset=-1

    for bench in "${benches[@]}"; do
        config="${bench}/sites/common_site_config.json"
        web=$(jq -r '.webserver_port // 8000' "$config")
        offset=$((web - BASE_WEB))
        if [ "$offset" -gt "$max_offset" ]; then
            max_offset=$offset
        fi
    done

    echo $((max_offset + 1))
}

check_ports() {
    offset=$1
    ports=(
        $((BASE_WEB + offset))
        $((BASE_SOCKET + offset))
        $((BASE_QUEUE + offset))
        $((BASE_SOCKETIO_REDIS + offset))
        $((BASE_CACHE + offset))
    )

    for port in "${ports[@]}"; do
        if ss -tuln | grep -q ":$port "; then
            echo -e "${RED}Error: Port $port is currently bound by an active process.${NC}"
            return 1
        fi
    done
    return 0
}

apply_shift() {
    offset=$1
    target_bench=$2

    if [ ! -f "$target_bench/sites/common_site_config.json" ]; then
        echo -e "${RED}Error: Run this command from inside a valid bench directory.${NC}"
        exit 1
    fi

    check_ports "$offset" || exit 1

    WEB=$((BASE_WEB + offset))
    SOCKET=$((BASE_SOCKET + offset))
    QUEUE=$((BASE_QUEUE + offset))
    SOCKET_REDIS=$((BASE_SOCKETIO_REDIS + offset))
    CACHE=$((BASE_CACHE + offset))

    echo -e "${YELLOW}Applying Port Offset: +$offset to $(basename "$target_bench")...${NC}"

    cd "$target_bench" || exit 1

    bench set-config -g webserver_port $WEB
    bench set-config -g socketio_port $SOCKET
    bench set-config -g redis_queue "redis://127.0.0.1:$QUEUE"
    bench set-config -g redis_socketio "redis://127.0.0.1:$SOCKET_REDIS"
    bench set-config -g redis_cache "redis://127.0.0.1:$CACHE"

    bench setup redis
    bench setup procfile

    echo -e "${GREEN}Success! $(basename "$target_bench") is now cleanly bound to port block $WEB.${NC}"
}

ensure_nginx() {
    if ! command -v nginx &> /dev/null; then
        echo -e "${YELLOW}Installing Nginx...${NC}"
        sudo dnf install epel-release -y > /dev/null 2>&1
        sudo dnf install nginx -y > /dev/null 2>&1
    fi
    sudo systemctl enable nginx --now > /dev/null 2>&1
}

ensure_supervisor() {
    if ! command -v supervisord &> /dev/null; then
        echo -e "${YELLOW}Installing Supervisor...${NC}"
        sudo dnf install epel-release -y > /dev/null 2>&1
        sudo dnf install supervisor -y > /dev/null 2>&1
    fi
    sudo systemctl enable supervisord --now > /dev/null 2>&1
}

setup_workers() {
    target_bench=${1:-$PWD}
    bench_name=$(basename "$target_bench")

    if [ ! -f "$target_bench/sites/common_site_config.json" ]; then
        echo -e "${RED}Error: Run this command from inside a valid bench directory.${NC}"
        exit 1
    fi

    cd "$target_bench" || exit 1

    echo -e "${BLUE}1. Ensuring Supervisor is active...${NC}"
    ensure_supervisor

    echo -e "${BLUE}2. Generating lightweight Supervisor configs...${NC}"
    bench set-config -g bench_name "$bench_name"
    bench setup supervisor

    echo -e "${BLUE}3. Linking bench to system Supervisor...${NC}"
    sudo ln -sf "$target_bench/config/supervisor.conf" "/etc/supervisord.d/$bench_name.ini"

    echo -e "${BLUE}4. Disabling Auto-Start to preserve RAM...${NC}"
    sudo sed -i 's/autostart=true/autostart=false/g' "/etc/supervisord.d/$bench_name.ini"

    sudo supervisorctl update > /dev/null 2>&1 || true

    echo -e "${GREEN}Success! Background workers are configured but currently STOPPED.${NC}"
    echo -e "${YELLOW}Run 'akwad-bench start' when you want to work on this bench.${NC}"
}

start_bench() {
    bench_name=$(basename "${1:-$PWD}")

    echo -e "${GREEN}Starting Redis...${NC}"
    sudo supervisorctl start "${bench_name}-redis:*" || true

    echo -e "${GREEN}Starting Workers...${NC}"
    sudo supervisorctl start "${bench_name}-workers:*" || true

    echo -e "${GREEN}Starting Web...${NC}"
    sudo supervisorctl start "${bench_name}-web:*" || true
}

stop_bench() {
    bench_name=$(basename "${1:-$PWD}")
    
    echo -e "${YELLOW}Stopping background workers for $bench_name...${NC}"
    sudo supervisorctl stop "${bench_name}-web:*" || true
    sudo supervisorctl stop "${bench_name}-workers:*" || true
    sudo supervisorctl stop "${bench_name}-redis:*" || true
}

logs_bench() {
    echo "1) Web (Server & WebSockets)"
    echo "2) Workers (Background Jobs)"
    echo "3) Scheduler"
    echo "4) Redis (Cache & Queue)"
    read -rp "Choose: " choice

    case $choice in
        1) tail -f logs/web.log logs/web.error.log ;;
        2) tail -f logs/worker.log logs/worker.error.log ;;
        3) tail -f logs/schedule.log logs/schedule.error.log ;;
        4) tail -f logs/redis-cache.log logs/redis-queue.log ;;
        *) echo -e "${RED}Invalid choice.${NC}" ;;
    esac
}

add_site() {
    site_name=$1
    target_bench=${2:-$PWD}

    if [ -z "$site_name" ]; then
        echo -e "${RED}Error: Provide a site name (e.g., crm.local)${NC}"
        exit 1
    fi

    if [ ! -f "$target_bench/sites/common_site_config.json" ]; then
        echo -e "${RED}Error: Run this command from inside a valid bench directory.${NC}"
        exit 1
    fi

    cd "$target_bench" || exit 1

    echo -e "${BLUE}1. Creating new site: $site_name...${NC}"
    bench new-site "$site_name"

    echo -e "${BLUE}2. Enabling DNS Multitenancy...${NC}"
    bench config dns_multitenant on

    echo -e "${BLUE}3. Configuring Nginx Reverse Proxy...${NC}"
    ensure_nginx
    bench setup nginx
    sudo ln -sf "$target_bench/config/nginx.conf" "/etc/nginx/conf.d/$(basename "$target_bench").conf"
    sudo systemctl reload nginx

    echo -e "${BLUE}4. Registering $site_name in Windows hosts file...${NC}"
    WIN_HOSTS="/mnt/c/Windows/System32/drivers/etc/hosts"

    if grep -q "$site_name" "$WIN_HOSTS"; then
        echo -e "${YELLOW}$site_name is already in your Windows hosts file.${NC}"
    else
        echo -e "${YELLOW}Please accept the Windows Administrator prompt to update your local DNS.${NC}"
        powershell.exe -Command "Start-Process powershell -ArgumentList '-Command \"Add-Content -Path C:\Windows\System32\drivers\etc\hosts -Value ''127.0.0.1 $site_name''\"' -Verb RunAs"
    fi

    echo -e "${GREEN}Success! Visit http://$site_name in your browser.${NC}"
}

destroy_bench() {
    target_bench=${1:-$PWD}
    bench_name=$(basename "$target_bench")

    if [ ! -f "$target_bench/sites/common_site_config.json" ]; then
        echo -e "${RED}Error: Run this command from inside the bench directory you want to destroy.${NC}"
        exit 1
    fi

    echo -e "${RED}WARNING: You are about to completely destroy the bench '$bench_name'.${NC}"
    echo -e "${YELLOW}This will drop databases, remove routing, and delete files.${NC}"
    read -p "Are you absolutely sure you want to proceed? (y/N): " confirm

    if [[ "$confirm" != [yY] && "$confirm" != [yY][eE][sS] ]]; then
        echo "Destruction cancelled."
        exit 0
    fi

    cd "$target_bench" || exit 1

    echo -e "${BLUE}1. Dropping databases for all active sites...${NC}"
    for site in sites/*/; do
        site_name=$(basename "$site")
        if [[ "$site_name" != "assets" && "$site_name" != "localhost" ]]; then
            echo "Dropping database for site: $site_name"
            bench --site "$site_name" drop-site --root-login root --root-password root --force || true
        fi
    done

    echo -e "${BLUE}2. Cleaning up routing and background workers...${NC}"
    if [ -L "/etc/nginx/conf.d/$bench_name.conf" ] || [ -f "/etc/nginx/conf.d/$bench_name.conf" ]; then
        sudo rm -f "/etc/nginx/conf.d/$bench_name.conf"
        sudo systemctl reload nginx > /dev/null 2>&1
    fi

    if command -v supervisorctl &> /dev/null; then
        sudo supervisorctl stop "$bench_name:*" > /dev/null 2>&1 || true
        sudo rm -f "/etc/supervisord.d/$bench_name.ini"
        sudo supervisorctl update > /dev/null 2>&1 || true
    fi

    echo -e "${BLUE}3. Obliterating the bench directory...${NC}"
    cd ~ || exit 1
    rm -rf "$target_bench"

    echo -e "${GREEN}Success! Bench '$bench_name' has been completely wiped from the system.${NC}"
}

case "$1" in
    status)
        show_dashboard
        ;;
    auto)
        apply_shift "$(get_next_offset)" "${2:-$PWD}"
        ;;
    assign)
        apply_shift "$2" "${3:-$PWD}"
        ;;
    add-site)
        add_site "$2" "${3:-$PWD}"
        ;;
    setup-workers)
        setup_workers "${2:-$PWD}"
        ;;
    start)
        start_bench "${2:-$PWD}"
        ;;
    stop)
        stop_bench "${2:-$PWD}"
        ;;
    logs)
        logs_bench "${2:-$PWD}"
        ;;
    destroy)
        destroy_bench "${2:-$PWD}"
        ;;
    *)
        echo -e "${BLUE}=== Akwad Bench Manager ===${NC}"
        echo "Usage:"
        echo "  akwad-bench status             - View all benches and running status."
        echo "  akwad-bench add-site <domain>  - Create site and configure Nginx DNS routing."
        echo "  akwad-bench setup-workers      - Bind bench to Supervisor (Auto-start disabled)."
        echo "  akwad-bench start              - Start background processes for current bench."
        echo "  akwad-bench stop               - Stop background processes (Save RAM/CPU)."
        echo "  akwad-bench logs               - Tail live web logs for current bench."
        echo "  akwad-bench auto               - Auto-detect and fix port collisions."
        echo "  akwad-bench destroy            - Safely wipe the bench and databases."
        ;;
esac
